# Fichier où sont enregistrées les inscriptions (une ligne JSON par famille).
# Par défaut : ./data/waitlist.jsonl
WAITLIST_FILE=

# Clé API Anthropic, nécessaire au tuteur IA (conversations en derja).
ANTHROPIC_API_KEY=
# Modèle du tuteur. Par défaut : claude-opus-5-5
TUTOR_MODEL=

# Voix naturelle du tuteur (Azure Speech, voix marocaine, algérienne, tunisienne).
# Sans ces deux variables, l'app utilise la voix du navigateur, plus robotique.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
